# ─────────────────────────────────────────────────────────────────────────────
# StockSense Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://stocksense_user:your_db_password@localhost:5432/stocksense

# ─────────────────────── JWT ─────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─────────────────────── SMTP (password-reset OTP email) ─────────────────────
# All SMTP_ variables are REQUIRED for email delivery.
# If these are unset, POST /forgot-password returns HTTP 503.

# Hostname of your SMTP server
SMTP_HOST=smtp.gmail.com

# SMTP port (587 = STARTTLS, 465 = SSL, 25 = plain)
SMTP_PORT=587

# SMTP login username (usually your email address)
SMTP_USERNAME=your-email@gmail.com

# SMTP login password or app-specific password
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-password

# Optional: custom From header ("Display Name <address>")
# Defaults to SMTP_USERNAME if not set.
SMTP_FROM=StockSense <no-reply@yourdomain.com>

# Use STARTTLS (default: 1 = yes).
# Set to 0 if your provider does not support STARTTLS.
SMTP_USE_TLS=1

# Use SMTP_SSL wrapper instead of STARTTLS (default: 0 = no).
# Set to 1 for port 465 SSL connections.
SMTP_USE_SSL=0

# ─────────────────────── Development / Testing only ──────────────────────────
# STOCKSENSE_DEV_EXPOSE_OTP=1
#   When set to "1" the /forgot-password response includes the OTP in demo_otp.
#   The OTP is also surface in debug logs (masked: first 2 chars only).
#   NEVER set this in production.
STOCKSENSE_DEV_EXPOSE_OTP=0
